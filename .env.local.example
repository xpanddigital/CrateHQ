NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key
APIFY_TOKEN=your_apify_token
CREDENTIALS_ENCRYPTION_KEY=your_credentials_encryption_key

# Cron worker auth (must match the Bearer token configured in Vercel cron settings)
CRON_SECRET=your_cron_secret

# Google Gemini (used by /api/admin/generate-image — Content Studio Imagen calls)
GEMINI_API_KEY=your_gemini_api_key

# Perplexity (used by scripts/find-emails-perplexity.ts and the perplexity
# deep-dive scripts — only needed if you run those scripts)
PERPLEXITY_API_KEY=your_perplexity_api_key

# --- GHL (Go High Level) ---
# Webhook secret is MANDATORY — without it the conversations webhook returns 503.
GHL_WEBHOOK_SECRET=your_ghl_webhook_secret
# Optional override for the GHL API base. Defaults to https://services.leadconnectorhq.com.
GHL_API_BASE=https://services.leadconnectorhq.com

# --- Instantly (email outreach) ---
# Global Instantly API key (fallback when no per-user integration is configured).
INSTANTLY_API_KEY=your_instantly_api_key
# Webhook secret is MANDATORY — without it the webhook returns 503.
# Sent by Instantly as the `x-webhook-secret` header (NOT a query param).
INSTANTLY_WEBHOOK_SECRET=your_instantly_webhook_secret

# --- Stripe ---
# Get from https://dashboard.stripe.com/test/apikeys (test mode first).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (locally)
# or the webhook endpoint detail page in the Stripe dashboard (deployed).
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — populated by `npx ts-node scripts/setup-stripe-products.ts`.
# That script creates Products + Prices in your Stripe account (idempotent)
# and prints the env block to paste here.
STRIPE_PRICE_STARTER_ONBOARDING=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ONBOARDING=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_ONBOARDING=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_WHALE_ONBOARDING=
STRIPE_PRICE_WHALE_MONTHLY=
STRIPE_PRICE_WHALE_ANNUAL=

# --- Resend (ops alerts: signups, payment failures, webhook errors) ---
RESEND_API_KEY=re_...
# From praecora.com (verified domain). Override if you use a different sender.
RESEND_FROM=alerts@praecora.com
# Where ops alerts go.
ALERT_EMAIL_TO=joel@xpanddigital.io

# --- Optional: external alerting for DM-agent critical errors ---
# If set, /api/dm-agent/heartbeat posts a Slack/Discord-style message here
# when an IG account reports a critical failure. Leave blank to disable.
ALERT_WEBHOOK_URL=

# --- GeeLark (cloud phones) ---
# Required for /api/admin/cloud-phones/* and the auto-provisioning step of
# the alias generator. Get from the GeeLark dashboard:
#   Personal Center → Developer → Open API
# GeeLark's dashboard issues an "App ID" + "API Key" pair, but we use
# Token mode (Bearer) which only needs the API Key. App ID is optional
# and kept for reference / forward-compat with Key (HMAC) mode.
GEELARK_API_KEY=
GEELARK_APP_ID=
# Optional override. Defaults to https://openapi.geelark.com.
GEELARK_API_BASE=https://openapi.geelark.com
# Optional override for the dashboard deep-link template. {id} is
# substituted with the phone's profile id. The default is a best guess
# from the dashboard URL pattern — verify by opening a phone in the
# GeeLark dashboard once and copying the URL.
GEELARK_DEEP_LINK_TEMPLATE=https://app.geelark.com/cloudPhones/{id}

# --- GeeLark default proxy (REQUIRED for provisioning, set ONE) ---
# GeeLark's addNew endpoint rejects phone creation without a proxy spec.
# Set exactly ONE of the three below (in order of precedence). All three
# unset → provisioning will fail with "proxy information error" (45006).
#
# Option 1: BYO proxy URL (use your own residential / mobile proxy)
GEELARK_DEFAULT_PROXY_INFORMATION=
#
# Option 2: Dynamic proxy from a provider configured in GeeLark dashboard.
# Valid values: IPHTML / kookeey / Luminati / rolaip / Proxyma / DECODO / NodeMaven / kookeeyMobile
GEELARK_DEFAULT_DYNAMIC_PROXY=
GEELARK_DEFAULT_DYNAMIC_PROXY_LOCATION=us
#
# Option 3: Use a proxy already saved in your GeeLark account by its serial number
GEELARK_DEFAULT_PROXY_NUMBER=
